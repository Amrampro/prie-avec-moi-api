generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  passwordHash String
  avatarUrl    String?
  isAdmin      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  favorites    Favorite[]
  posts        Post[]
  postLikes    PostLike[]
  postComments PostComment[]

  @@map("user")
}

model Series {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String?
  coverUrl    String?
  isPublished Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  meditations Meditation[]

  @@map("series")
}

model Meditation {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  imageUrl      String?
  bodyText      String
  footerText    String?
  audioUrl      String?
  audioDuration String?
  isPublished   Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  seriesId      String?
  series        Series?    @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  favorites     Favorite[]

  @@map("meditation")
}

model Favorite {
  id           String     @id @default(cuid())
  userId       String
  meditationId String
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  meditation   Meditation @relation(fields: [meditationId], references: [id], onDelete: Cascade)

  @@unique([userId, meditationId])
  @@map("favorite")
}

model Event {
  id          String   @id @default(cuid())
  name        String
  place       String?
  address     String?
  imageUrl    String?
  theme       String?
  description String?
  startDate   DateTime
  endDate     DateTime
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate, endDate])
  @@index([isPublished])
  @@map("event")
}

model Post {
  id          String      @id @default(cuid())
  text        String      @db.Text
  isPublished Boolean     @default(false)

  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  images      PostImage[]
  likes       PostLike[]
  comments    PostComment[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([createdAt])
  @@index([authorId])
  @@map("post")
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([postId])
  @@map("postimage")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
  @@map("postlike")
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  text      String

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([userId])
  @@map("postcomment")
}
